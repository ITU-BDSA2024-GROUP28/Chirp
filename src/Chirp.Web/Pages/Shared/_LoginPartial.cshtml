@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Chirp.Core
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            @if (User.Identity!=null)
            {
                <a class="nav-link text-dark" asp-area="Identity"
                   asp-page="/Account/Manage/Index" title="Manage">
                    Hello @User.Identity.Name!</a>   
            }
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                  asp-area="Identity" method="post" >
                <button class="nav-link btn btn-link text-dark"
                        type="submit">Logout</button>
            </form>
        </li>
    }
    else
    {
        <div>
            <a class="nav-link text-dark" asp-area="Identity" 
               asp-page="/Account/Register"
            >Register</a>
        </div>
        <div>
            <a class="nav-link text-dark" asp-area="Identity" 
               asp-page="/Account/Login">Login</a>
        </div>
    }
</ul>

<style>
    /* Hover effect for the entire div */
    .navbar-nav > div:hover { 
        background-color: #ce8181;
        border-color: #ce8181;
    }
    /* Styling of divs around Register and Login links */
    .navbar-nav > div {
        display: inline-block;
        margin: 0 5px; 
        border: 1px solid #ce8181; 
        padding: 5px 10px; 
        transition: background-color 0.3s ease, border-color 0.3s ease;
    }
    /* Style the links */
    .navbar-nav > div .nav-link {
        text-decoration: none; 
    }
</style>
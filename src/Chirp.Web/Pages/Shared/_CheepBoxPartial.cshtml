@using Microsoft.AspNetCore.Identity
@model Chirp.Web.Pages.Shared.CheepBoxPartialModel

@if (User.Identity.IsAuthenticated)
{
    <head>
    </head>
    <body>
    <div class="cheepbox">
        <h3>What's on your mind @(User.Identity.Name)?</h3>
        <form method="post">
            <input style="float: left" type="text" asp-for="Text" maxlength="160">
            <input type="submit" value="Share">
        </form>
    </div>
    </body>
}
@page "/{author}"
@using Chirp.Infrastructure.Services
@model Chirp.Web.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Chirp!";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("author");}

<style> /*Used for the page buttons*/

    .pages {
        margin: 1%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .page-number {
        margin: 2%;
    }
    

</style>

<div>
    
    <h2> @routeName's Timeline
        @if (User.Identity!.IsAuthenticated && User.Identity.Name != routeName?.ToString())
        {
            @if (@routeName != null && !Model.CheckIfFollowing(@routeName.ToString() ?? string.Empty))
            {
                <form method="post" asp-page-handler="Follow">
                    <input type="hidden" name="userToFollow" value="@routeName">
                    <button style="border-radius: 7px" class="btn btn-default">Follow</button>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="Unfollow">
                    <input type="hidden" name="userToUnFollow" value="@routeName">
                    <button style="border-radius: 7px" class="btn btn-default">Unfollow</button>
                </form>
            }
        }
        <partial name="Shared/_CheepBoxPartial" model="Model.CheepBoxPartialModel"/>
    </h2>

    @if (Model.Cheeps.Any())
    {
        <ul id="messagelist" class="cheeps">
            @foreach (var cheep in Model.Cheeps)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@cheep.Author">@cheep.Author</a>
                        </strong>
                        <div>
                            @cheep.Text
                        </div>
                        <small>&mdash; @Time.ConvertToString(@cheep.Timestamp)</small>
                   
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no cheeps so far.</em>
    }

    <div class="pages">
        @if (Model.PageNr > 0) //To make sure the user doesn't go beyond the first page
        {
            <a href="/@(routeName)/?page=@(Model.PageNr - 1)">
                <button style="border-radius: 7px">&lt;</button> <!--The &lt; means "<"-->
            </a>
        }
        <div class="page-number">
            <p>@Model.PageNr</p>
        </div>
        @if (Model.HasMorePages)
        {
            <a href="/@(routeName)/?page=@(Model.PageNr + 1)">
                <button style="border-radius: 7px">&gt;</button> <!--The &gt; means ">"-->
            </a>
        }
    </div>
</div>


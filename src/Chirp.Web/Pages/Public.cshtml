@page "/"
@using Chirp.Infrastructure.Services
@using Microsoft.AspNetCore.Identity
@model Chirp.Web.Pages.PublicModel

@{
    ViewData["Title"] = "Chirp!";
    Layout = "Shared/_Layout";
}

<style> /*Used for the page buttons*/

    .pages {
        margin: 1%;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .page-number {
        margin: 1%;
    }
    
</style>

<div>
    <h2> Public Timeline
        <partial name="Shared/_CheepBoxPartial" model="Model.CheepBoxPartialModel"/>
    </h2>


    @if (Model.Cheeps != null)
    {
        @if (Model.Cheeps.Any())
        {
            <ul id="messagelist" class="cheeps">
                @foreach (var cheep in Model.Cheeps)
                {
                    <li>
                        <p>
                            <strong>
                                <a href="/@cheep.Author">@cheep.Author</a>
                            </strong>
                            @cheep.Text
                            <small>&mdash; @Time.ConvertToString(@cheep.Timestamp)</small>
                        </p>
                    </li>
                }
            </ul>
        }
        else
        {
            <em>There are no cheeps so far.</em>
        }
    }
    <div class="pages">
    @if (Model.PageNr > 0) //To make sure the user doesn't go beyond the first page
    { 
        <a href="/?page=@(Model.PageNr - 1)"> 
            <button>&lt;</button> <!--The &lt; means "<"-->
        </a>
    }
        <div class="page-number">
            <p>@Model.PageNr</p>
        </div>
        <a href="/?page=@(Model.PageNr + 1)">
            <button>&gt;</button> <!--The &gt; means ">"-->
        </a>
    </div>
</div>


@page "/{author}/Followers"
@using Chirp.Infrastructure.Services
@using Chirp.Web.Pages
@using Microsoft.AspNetCore.Identity
@model Chirp.Web.Pages.Followers

@{
    ViewData["Title"] = "Followers";
    Layout = "Shared/_Layout";
    var author = HttpContext.GetRouteValue("author");
}

<!DOCTYPE html>

<html>
<head>
    <title></title>
</head>
<body>
<div>
    <ul>
        @foreach (var follower in Model.ListOfFollowers)
        {
            <li>@follower.Name</li>
        }
    </ul>
</div>
</body>
</html>
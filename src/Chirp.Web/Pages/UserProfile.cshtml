@page "/{author}/MyAccount"
@using Chirp.Infrastructure.Services
@using Chirp.Web.Pages
@using Microsoft.AspNetCore.Identity
@model Chirp.Web.Pages.UserProfile

@{
    ViewData["Title"] = "My account";
    Layout = "Shared/_Layout";
    var author = HttpContext.GetRouteValue("author");
}
<body>
<div>
    @if (User.Identity!.IsAuthenticated)
    { 
        <h2>Personal Information</h2> 
        
        <p><strong>Username:</strong> @User.Identity.Name </p> 
        <p><strong>Email:</strong> @Model.Email </p>
    }
</div>
<br/>

<div>
    <a href="/@(author)/Following">
        <button style="border-radius: 7px">Following</button>
    </a>
    <a href="/@(author)/Followers">
        <button style="border-radius: 7px">Followers</button>
    </a>
    <form method="post" asp-page-handler="Delete" onsubmit="return confirmDeletion()">
        <input type="hidden" name="name" value="@User.Identity!.Name">
        <button style="border-radius: 7px" type="submit">Forget Me</button>
    </form>
</div>

<br/>
<br/>
<h2>My cheeps</h2>
<div>
    @if (Model.CheepList.Any())
    {
        <ul id="messagelist" class="cheeps">
            @foreach (var cheep in Model.CheepList)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@cheep.Author">@cheep.Author</a>
                        </strong>
                        <div>
                            @cheep.Text
                        </div>
                        <small>&mdash; @Time.ConvertToString(@cheep.Timestamp)</small>
                        <br/>
                        <form method="post" asp-page-handler="DeleteCheep" onsubmit="return confirmCheepDeletion()">
                            <input type="hidden" name="cheepId" value="@cheep.CheepId">
                            <br/>
                            <button type="submit" style="font-size: 10px; padding: 2px 5px; border-radius: 3px">Delete</button>
                        </form>

                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>You haven't cheeped yet!</em>
    } 
</div>

<script>
    function confirmDeletion() {
        // Show a confirmation dialog
        return confirm("Are you sure you want to delete your account? This action cannot be undone.");
    }
    
    function confirmCheepDeletion() {
        // Show a confirmation dialog
        return confirm("Are you sure you want to delete your cheep?");
    }
</script>
</body>